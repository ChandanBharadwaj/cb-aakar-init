# Base URL of the Aakar API (services/api, Spring Boot) that serves /admin/api/*. Used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: a different base URL for server-side calls only (e.g. a docker-compose service name).
# Falls back to NEXT_PUBLIC_API_URL when unset.
# API_URL=http://api:8080
