# Copy to .env at the repo root for local runs outside Docker. Never commit .env.
AAKAR_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/aakar
AAKAR_DB_USER=aakar
AAKAR_DB_PASSWORD=aakar
AAKAR_GEOMETRY_URL=http://localhost:8081
AAKAR_API_PUBLIC_URL=http://localhost:8080
AAKAR_AMQP_URL=amqp://aakar:aakar@localhost:5672/
AAKAR_STORAGE=local
AAKAR_ASSET_DIR=./.aakar-assets
AAKAR_PUBLIC_URL=http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AAKAR_PROFILE=local   # shows mock-only hints in the portal; anything else hides them
AAKAR_PROFILE=local               # API: 'production' refuses mock adapters (ADR-0013)
AAKAR_WEB_URL=http://localhost:3000
