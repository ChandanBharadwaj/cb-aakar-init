{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aakar.studio/schemas/design-spec.v1.json",
  "title": "Aakar Design Spec v1",
  "description": "The only thing the co-designer agent (or a viewer control) may hand to the geometry service. Geometry is produced by our own templates from this document; no executable code ever crosses this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "family", "template", "params"],
  "properties": {
    "spec_version": { "const": "1.0" },
    "family": {
      "type": "string",
      "description": "Template family id, e.g. phone_stand, table_lamp.",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "template": {
      "type": "string",
      "description": "Template id with version, e.g. jharokha_phone_stand@1.",
      "pattern": "^[a-z][a-z0-9_]*@[0-9]+$"
    },
    "params": {
      "type": "object",
      "description": "Parameter values. Keys and ranges are defined by the template descriptor.",
      "additionalProperties": { "type": ["number", "integer", "boolean", "string"] }
    },
    "features": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/feature" }
    },
    "style": {
      "type": "string",
      "enum": ["none", "jaipur_heritage", "modern_zen", "cyber_desi", "warli_line", "comic_pop"],
      "default": "none",
      "description": "Style variant of the piece; an experience (experience.v1.json style) may preset it. comic_pop is Katha's comic-book look."
    },
    "material": {
      "type": "string",
      "description": "Digital material id, e.g. terracotta_silk. Affects rendering and price, never geometry.",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "constraints": { "$ref": "#/$defs/constraints" }
  },
  "$defs": {
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_wall_mm": { "type": "number", "minimum": 0.8, "default": 1.2 },
        "max_overhang_deg": { "type": "number", "minimum": 30, "maximum": 90, "default": 55 },
        "bed_mm": {
          "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 3, "maxItems": 3, "default": [250, 250, 250]
        }
      }
    },
    "feature": {
      "oneOf": [
        { "$ref": "#/$defs/emboss_text" },
        { "$ref": "#/$defs/motif" },
        { "$ref": "#/$defs/relief_image" },
        { "$ref": "#/$defs/hero_mesh" }
      ]
    },
    "content_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upload_id", "url"],
      "description": "Customer content behind a relief_image or hero_mesh feature. The API resolves upload_id to a URL the geometry service can fetch; origin says whether the customer uploaded it or a generative provider produced it.",
      "properties": {
        "upload_id": { "type": "string", "format": "uuid" },
        "url": { "type": "string" },
        "format": { "type": "string", "enum": ["png", "jpg", "webp", "heic", "stl", "glb", "3mf", "obj", "ply", "off", "gltf"] },
        "origin": { "type": "string", "enum": ["upload", "generated"], "default": "upload" },
        "provider": { "type": "string", "description": "Generative provider id when origin is generated." }
      }
    },
    "relief_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "anchor"],
      "description": "Chhavi: a photo or image becomes a heightfield relief on a surface anchor (the MakerLab keychain and lithophane pattern).",
      "properties": {
        "type": { "const": "relief_image" },
        "source": { "$ref": "#/$defs/content_source" },
        "anchor": { "type": "string", "description": "A surface anchor id from the template descriptor." },
        "mode": { "type": "string", "enum": ["emboss", "deboss", "lithophane"], "default": "emboss" },
        "relief_mm": { "type": "number", "minimum": 0.2, "maximum": 3, "default": 0.6 },
        "fit": { "type": "string", "enum": ["contain", "cover"], "default": "contain" },
        "invert": { "type": "boolean", "default": false },
        "cutout": { "type": "string", "enum": ["none", "silhouette"], "default": "none" }
      }
    },
    "hero_mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "anchor"],
      "description": "Roop: the customer's own 3D form (uploaded or generated), repaired, scaled into a volume anchor and fused onto the carrier body. The raw_print family carries exactly one hero_mesh and no body; it has no template params, so its size (fit longest with longest_mm inside the family envelope) and orientation live on this feature.",
      "properties": {
        "type": { "const": "hero_mesh" },
        "source": { "$ref": "#/$defs/content_source" },
        "anchor": { "type": "string", "description": "A volume anchor id from the template descriptor." },
        "fit": { "type": "string", "enum": ["contain", "longest"], "default": "contain" },
        "longest_mm": { "type": "number", "minimum": 5, "maximum": 250, "description": "Target longest dimension when fit is longest." },
        "yaw_deg": { "type": "number", "minimum": 0, "maximum": 360, "default": 0 },
        "orientation": { "type": "string", "enum": ["as_uploaded", "lay_flat"], "default": "as_uploaded" }
      }
    },
    "emboss_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "anchor"],
      "properties": {
        "type": { "const": "emboss_text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 40 },
        "script": {
          "type": "string",
          "enum": ["latin", "devanagari", "telugu", "tamil", "kannada", "bengali", "gujarati"],
          "description": "Detected or chosen script; picks the shaping font."
        },
        "font": { "type": "string" },
        "depth_mm": { "type": "number", "minimum": 0.4, "maximum": 3, "default": 1.2 },
        "height_mm": { "type": "number", "minimum": 4, "maximum": 60 },
        "anchor": { "type": "string", "description": "Anchor id from the template descriptor." },
        "projection": { "type": "string", "enum": ["planar", "cylindrical", "conformal"], "default": "planar" },
        "mode": { "type": "string", "enum": ["emboss", "deboss"], "default": "emboss" }
      }
    },
    "motif": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "motif_id", "anchor"],
      "properties": {
        "type": { "const": "motif" },
        "motif_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "anchor": { "type": "string" },
        "scale": { "type": "number", "minimum": 0.2, "maximum": 1, "default": 1, "description": "1 fills the anchor's spot; smaller scales shrink the motif, down to the library's min_scale for that motif." },
        "depth_mm": { "type": "number", "minimum": 0.4, "maximum": 3, "default": 1.0 },
        "mode": { "type": "string", "enum": ["emboss", "deboss"], "default": "deboss" }
      }
    }
  }
}
